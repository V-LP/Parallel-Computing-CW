#!/usr/bin/env bash
# Runs the console client: ./search "white whale"   (see README, section "CLI").
# Builds cli/target/search-cli.jar on the first run if it is missing.
set -u
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
JAR="$ROOT/cli/target/search-cli.jar"

if ! command -v java >/dev/null 2>&1; then
  echo "Java 21 не знайдено. Встановіть JDK 21 або запустіть через Docker: docker compose run --rm cli \"запит\"" >&2
  exit 1
fi

if [ ! -f "$JAR" ]; then
  if ! command -v mvn >/dev/null 2>&1; then
    echo "Файл cli/target/search-cli.jar відсутній, а Maven не знайдено." >&2
    echo "Встановіть Maven 3.9+ і JDK 21 та виконайте: mvn -q -pl cli -am package -DskipTests" >&2
    echo "або запустіть через Docker: docker compose run --rm cli \"запит\"" >&2
    exit 1
  fi
  echo "Збираю CLI (один раз)..." >&2
  if ! (cd "$ROOT" && mvn -q -pl cli -am package -DskipTests) >&2; then
    echo "Не вдалося зібрати CLI. Подивіться повідомлення Maven вище." >&2
    exit 1
  fi
fi

exec java -jar "$JAR" "$@"
