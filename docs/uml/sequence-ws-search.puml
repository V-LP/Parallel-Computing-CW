@startuml sequence-ws-search
title Послідовність: потоковий пошук (WebSocket /ws/search)

skinparam shadowing false
autonumber

actor "Клієнт\n(Web UI / CLI / WsClient)" as Client
participant "Jetty\n(потік з'єднання)" as Jetty
participant WsSearchHandler
participant "ThreadPool\n(SEARCH_THREADS)" as Pool
participant "Connection\n(sendLock)" as Conn
participant SearchService
participant QueryExpander
participant "Ollama" as Ollama

Client -> Jetty : відкрити /ws/search
Jetty -> WsSearchHandler : onConnect(session, sink)
Client -> Jetty : {"query":"..."}
Jetty -> WsSearchHandler : onMessage(session, text)
WsSearchHandler -> Conn : enqueue(text)
note right of Conn : черга з'єднання (до 16);\nпереповнена -> error + done
Conn -> Pool : submit(drain), якщо воркер ще не працює
Jetty --> Client : (потік Jetty вільний, повертається одразу)

== Воркер пулу: drain() бере тексти з черги по одному ==
Pool -> Conn : drain() -> runPipeline(text)

alt текст не JSON, немає query, порожній, не рядок або задовгий
  Conn -> Conn : parseQuery -> BadInputException
  Conn --> Client : {"stage":"error","data":{"message":"..."}}
  Conn --> Client : {"stage":"done"}
  note right : з'єднання лишається відкритим
else коректний запит
  == Етап 1: розширення запиту ==
  Conn -> SearchService : expandQuery(query)
  SearchService -> QueryExpander : expand(query)
  alt є в LRU-кеші
    QueryExpander --> SearchService : терміни з кешу
  else немає в кеші
    QueryExpander -> QueryExpander : tryAcquire Semaphore(1)\n(чекає обмежений час)
    alt модель зайнята
      QueryExpander --> SearchService : [] (fallback)
    else дозвіл отримано
      QueryExpander -> Ollama : POST /api/generate
      alt відповідь отримано
        Ollama --> QueryExpander : {"response":"[...]"}
        QueryExpander --> SearchService : expanded_terms (до 8)
      else недоступна / таймаут / HTTP 500 / сміття
        QueryExpander --> SearchService : [] (fallback)
      end
    end
  end
  SearchService --> Conn : QueryExpansion
  Conn --> Client : {"stage":"query_expansion",\n"data":{"original":"...","expanded_terms":[...]}}
  note right : надсилається одразу, під sendLock

  == Етап 2: пошук ==
  Conn -> SearchService : searchExpanded(expansion, 10)
  note right of SearchService : оригінальні терміни 1.0,\nрозширені 0.5;\ntime_ms = лише цей етап
  SearchService --> Conn : List<SearchHit>
  Conn --> Client : {"stage":"keyword_search",\n"data":{"results":[...],"time_ms":12}}
  Conn --> Client : {"stage":"done"}
end

opt клієнт зник посеред роботи
  Conn -> Conn : send повертає false (sink закритий або виняток)
  note right : пайплайн тихо завершується,\nвинятків назовні немає,\nворкер вільний
end

Client -> Jetty : закрити з'єднання
Jetty -> WsSearchHandler : onClose(session)
WsSearchHandler -> Conn : close() (черга очищається)

note over Jetty, Ollama
  Повільна Ollama займає лише воркер пулу (і один дозвіл Semaphore),
  потоки Jetty та інші з'єднання не блокуються.
  Простій WS без трафіку ліміт Jetty 30 с збільшено до 10 хв (WS_IDLE_TIMEOUT).
end note

@enduml
