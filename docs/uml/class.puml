@startuml class
title Діаграма класів (пакети ua.coursework.engine.*)

skinparam shadowing false
skinparam classAttributeIconSize 0
set separator none
hide empty members

package "api" {
  class ApiServer {
    +ApiServer(ollama, indexManager, searchService, dataDir)
    +create(): Javalin
  }
  note right of ApiServer
    Маршрути: /api/health, /api/index,
    /api/search, /api/stats
    (далі: /ws/search)
    DATA_DIR задає каталог датасету
  end note

  class HealthResponse <<record>> {
    status: String
    ollama: boolean
  }
  class IndexRequest <<record>> {
    threads: Integer
  }
  class ErrorResponse <<record>> {
    status: String
    message: String
  }
  class IndexResponse <<record>> {
    status: String
    documentsIndexed: int
    timeMs: long
  }
  class SearchRequest <<record>> {
    query: String
    mode: String  (keyword)
  }
  class SearchResult <<record>> {
    docId: String
    score: double
    snippet: String
  }
  class SearchResponse <<record>> {
    results: List<SearchResult>
    timeMs: long
  }
  class StatsResponse <<record>> {
    documents: int
    indexBuildTimeMs: long
    threadsUsed: int
  }
  class WsMessage <<record>> {
    stage: String
    data: Object
  }
}

package "search" {
  class SearchService {
    +DEFAULT_TOP_K: int = 10
    +search(query: String, topK: int): List<SearchHit>
    +keywordSearch(terms: List<String>, topK: int): List<SearchHit>
    +keywordSearchWeighted(terms: List<WeightedTerm>, topK: int): List<SearchHit>
  }
  class WeightedTerm <<record>> {
    term: String
    weight: double
  }
  class SearchHit <<record>> {
    docId: String
    score: double
    snippet: String
  }
  class SnippetExtractor {
    +extract(docId: String, terms: Collection<String>): String
  }
  note bottom of SearchService
    TF-IDF: tf = 1 + ln(freq), idf = ln(1 + N/df),
    score = coord * sum(weight * tf * idf) / (1 + ln(length)).
    OR-семантика, top-K через PriorityQueue,
    рівні оцінки впорядковуються за doc_id.
  end note
}

package "llm" {
  class QueryExpander {
    -llmGate: Semaphore(1)
    +expand(query: String): List<String>
  }
  class OllamaClient {
    -baseUrl: String
    +isAvailable(): boolean
    +generate(prompt: String): String
  }
}

package "index" {
  class IndexManager {
    -current: IndexSnapshot  (volatile)
    -indexing: AtomicBoolean
    +current(): IndexSnapshot
    +rebuild(dataDir: Path, threads: int): IndexSnapshot
    +isIndexing(): boolean
  }
  class IndexSnapshot <<record>> {
    index: ConcurrentInvertedIndex
    documents: int
    buildTimeMs: long
    threadsUsed: int
  }
  class IndexingInProgressException <<exception>>
  class Indexer {
    +Indexer(index, tokenizer)
    +buildIndex(dataDir: Path, threads: int): int
  }
  class Tokenizer {
    +tokenize(text: String): List<String>
    +tokenize(reader: BufferedReader, sink: Consumer<String>)
    +forEachBodyLine(reader: BufferedReader, handler: Predicate<String>)
  }
  note bottom of Tokenizer
    нижній регістр, терміни 2..40 символів,
    стоп-слова (resource stopwords.txt),
    пропуск шапки й футера Gutenberg
  end note
  class ConcurrentInvertedIndex {
    -segments: Segment[]
    -termCount: AtomicInteger
    -postingCount: AtomicLong
    -docPaths: String[]
    -docLengths: int[]
    +addPosting(term: String, docId: int, frequency: int)
    +getPostings(term: String): List<Posting>
    +documentFrequency(term: String): int
    +termCount(): int
    +registerDocument(path: String): int
    +documentPath(docId: int): String
    +setDocumentLength(docId: int, length: int)
    +documentLength(docId: int): int
    +documentCount(): int
  }
  class Segment <<inner>> {
    -lock: ReentrantReadWriteLock
    -buckets: Entry[]
    -size: int
    -resize()
  }
  class Entry <<inner>> {
    term: String
    hash: int
    postings: ArrayList<Posting>
    next: Entry
  }
  class Posting <<record>> {
    docId: int
    termFrequency: int
  }
}

package "concurrent" {
  class ThreadPool {
    -queue: ArrayDeque<Runnable>
    -workers: Thread[]
    +ThreadPool(threads: int)
    +submit(task: Runnable)
    +shutdown()
    +awaitTermination(timeout: long, unit: TimeUnit): boolean
    +activeCount(): int
    +queueSize(): int
  }
  note right of ThreadPool
    Власна черга: synchronized + wait/notify.
    submit після shutdown ->
    RejectedExecutionException.
  end note
}

ApiServer --> SearchService
ApiServer --> IndexManager
ApiServer --> OllamaClient : health
ApiServer ..> HealthResponse
ApiServer ..> IndexResponse
ApiServer ..> SearchResponse
ApiServer ..> StatsResponse
ApiServer ..> ErrorResponse
ApiServer ..> IndexingInProgressException : 409
ApiServer ..> WsMessage

SearchService --> IndexManager : current().index()
SearchService --> Tokenizer
SearchService ..> QueryExpander : етап 8
SearchService --> WeightedTerm
SearchService ..> SearchHit : returns
SearchService --> SnippetExtractor : top-K snippets
SnippetExtractor --> Tokenizer : body lines
ApiServer ..> SearchRequest
SearchResponse "1" o-- "*" SearchResult

QueryExpander --> OllamaClient

IndexManager --> Indexer : creates for each build
IndexManager o-- IndexSnapshot : publishes
IndexSnapshot --> ConcurrentInvertedIndex
IndexManager ..> IndexingInProgressException : throws
Indexer --> ThreadPool : submits file tasks
Indexer --> Tokenizer
Indexer --> ConcurrentInvertedIndex : writes

ConcurrentInvertedIndex "1" *-- "N" Segment : striped locks
Segment "1" *-- "*" Entry : bucket lists
Entry "1" o-- "*" Posting

note bottom of ConcurrentInvertedIndex
  Власна хеш-таблиця, без готових concurrent-колекцій.
  Сегментів 64 за замовчуванням. Термін -> сегмент за хешем; запис під write-lock
  сегмента, читання під read-lock. getPostings повертає копію.
  Реєстр документів: окремий ReadWriteLock.
end note

note as JsonNote
  У JSON поля мають snake_case за контрактом API
  (documents_indexed, time_ms, doc_id тощо).
end note

@enduml
