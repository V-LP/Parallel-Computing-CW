@startuml class
title Діаграма класів (ua.coursework.engine.* і ua.coursework.cli)

skinparam shadowing false
skinparam classAttributeIconSize 0
set separator none
hide empty members

package "api" {
  class ApiServer {
    +ApiServer(ollama, indexManager, searchService, dataDir)
    +ApiServer(ollama, indexManager, searchService, dataDir, searchPool)
    +create(): Javalin
    -addWebSocket(app)
  }
  note right of ApiServer
    Маршрути: /api/health, /api/index,
    /api/search, /api/stats, WS /ws/search
    (WS лише з searchPool; 4-арг. конструктор = тільки REST)
    DATA_DIR задає каталог датасету
  end note

  class WsSearchHandler {
    +MAX_PENDING: int = 16
    +MAX_QUERY_LENGTH: int = 1000
    -connections: Map<Object, Connection>  (synchronizedMap)
    +onConnect(session: Object, sink: Sink)
    +onMessage(session: Object, text: String)
    +onClose(session: Object)
    +openConnections(): int
  }
  interface "WsSearchHandler.Sink" as Sink {
    +send(text: String)
    +isOpen(): boolean
  }
  class "WsSearchHandler.Connection" as Connection <<inner>> {
    -sendLock: Object
    -queueLock: Object
    -pending: ArrayDeque<String>
    -draining: boolean
    -closed: boolean (volatile)
    ~enqueue(text: String)
    -drain()
    -runPipeline(text: String)
    -send(messages: WsMessage...): boolean
  }
  note bottom of Connection
    Черга повідомлень на з'єднання, один воркер (drain)
    обробляє їх по черзі. Усі записи в сесію під sendLock.
    Розрив клієнта: send повертає false, пайплайн тихо зупиняється.
  end note

  class HealthResponse <<record>> {
    status: String
    ollama: boolean
  }
  class IndexRequest <<record>> {
    threads: Integer
  }
  class ErrorResponse <<record>> {
    status: String
    message: String
  }
  class IndexResponse <<record>> {
    status: String
    documentsIndexed: int
    timeMs: long
  }
  class SearchRequest <<record>> {
    query: String
    mode: String  (keyword)
  }
  class SearchResult <<record>> {
    docId: String
    score: double
    snippet: String
  }
  class SearchResponse <<record>> {
    results: List<SearchResult>
    timeMs: long
  }
  class StatsResponse <<record>> {
    documents: int
    indexBuildTimeMs: long
    threadsUsed: int
  }
  class WsMessage <<record>> {
    stage: String
    data: Object  (null для done, поле не пишеться)
    +queryExpansion(original, expandedTerms): WsMessage
    +keywordSearch(results, timeMs): WsMessage
    +error(message): WsMessage
    +done(): WsMessage
  }
  class "WsMessage.Expansion" as WsExpansion <<record>> {
    original: String
    expandedTerms: List<String>
  }
  class "WsMessage.Search" as WsSearch <<record>> {
    results: List<SearchResult>
    timeMs: long
  }
  class "WsMessage.Failure" as WsFailure <<record>> {
    message: String
  }
}

package "search" {
  class SearchService {
    +DEFAULT_TOP_K: int = 10
    +search(query: String, topK: int): List<SearchHit>
    +keywordSearch(terms: List<String>, topK: int): List<SearchHit>
    +keywordSearchWeighted(terms: List<WeightedTerm>, topK: int): List<SearchHit>
    +ORIGINAL_WEIGHT: double = 1.0
    +EXPANDED_WEIGHT: double = 0.5
    +expandQuery(query: String): QueryExpansion
    +searchExpanded(expansion: QueryExpansion, topK: int): List<SearchHit>
    +searchWithExpansion(query: String, topK: int): ExpandedSearch
  }
  class QueryExpansion <<record>> {
    original: String
    originalTerms: List<String>
    expandedTerms: List<String>
  }
  class ExpandedSearch <<record>> {
    expansion: QueryExpansion
    hits: List<SearchHit>
  }
  class WeightedTerm <<record>> {
    term: String
    weight: double
  }
  class SearchHit <<record>> {
    docId: String
    score: double
    snippet: String
  }
  class SnippetExtractor {
    +extract(docId: String, terms: Collection<String>): String
  }
  note bottom of SearchService
    TF-IDF: tf = 1 + ln(freq), idf = ln(1 + N/df),
    score = coord * sum(weight * tf * idf) / (1 + ln(length)).
    OR-семантика, top-K через PriorityQueue,
    рівні оцінки впорядковуються за doc_id.
  end note
}

package "llm" {
  interface TextGenerator {
    +generate(prompt: String): String
  }
  class QueryExpander {
    -llmGate: Semaphore(1)
    -cache: LRU LinkedHashMap
    +MAX_TERMS: int = 8
    +expand(query: String): List<String>
    ~parse(answer: String, queryTerms: List<String>): List<String>
  }
  class OllamaClient {
    -baseUrl: String
    -model: String
    -generateTimeout: Duration
    +fromEnv(): OllamaClient
    +isAvailable(): boolean
    +generate(prompt: String): String  (keep_alive 30m)
    +ensureModelAvailable()
    +ensureModelAvailableWithRetries(attempts: int, pauseMillis: long): boolean
  }
  class OllamaException <<checked>>
  note bottom of OllamaClient
    Main після ensureModelAvailable робить один
    прогрів generate("Say OK"); помилка лише в лог.
  end note
}

package "index" {
  class IndexManager {
    -current: IndexSnapshot  (volatile)
    -indexing: AtomicBoolean
    +current(): IndexSnapshot
    +rebuild(dataDir: Path, threads: int): IndexSnapshot
    +chunker(): Chunker
    +isIndexing(): boolean
  }
  class IndexSnapshot <<record>> {
    index: ConcurrentInvertedIndex
    documents: int
    buildTimeMs: long
    threadsUsed: int
  }
  class IndexingInProgressException <<exception>>
  class Indexer {
    +Indexer(index, tokenizer, chunker)
    +buildIndex(dataDir: Path, threads: int): int
    +booksIndexed(): int
  }
  class Chunker {
    -limitChars: long
    -minTailChars: long
    +ofKb(kb: int): Chunker
    +fromEnv(): Chunker
    +isEnabled(): boolean
    +docId(path: String, chunk: int): String
    +parseDocId(docId: String): DocRef
    +newSplitter(sink: LineSink): Splitter
    +forEachBodyLine(tokenizer, reader, sink)
  }
  class BookEncoding {
    +detect(file: Path): Charset
  }
  note bottom of Chunker
    Чанк = документ, doc_id = path#N.
    Закривається на першому рядку, де
    розмір >= ліміту (CHUNK_SIZE_KB * 1024).
    Хвіст < 1 КБ приєднується до попереднього.
  end note
  class Tokenizer {
    +tokenize(text: String): List<String>
    +tokenize(reader: BufferedReader, sink: Consumer<String>)
    +forEachBodyLine(reader: BufferedReader, handler: Predicate<String>)
  }
  note bottom of Tokenizer
    нижній регістр, терміни 2..40 символів,
    стоп-слова (resource stopwords.txt),
    пропуск шапки й футера Gutenberg
  end note
  class ConcurrentInvertedIndex {
    -segments: Segment[]
    -termCount: AtomicInteger
    -postingCount: AtomicLong
    -docPaths: String[]
    -docLengths: int[]
    +addPosting(term: String, docId: int, frequency: int)
    +getPostings(term: String): List<Posting>
    +documentFrequency(term: String): int
    +termCount(): int
    +registerDocument(path: String): int
    +documentPath(docId: int): String
    +setDocumentLength(docId: int, length: int)
    +documentLength(docId: int): int
    +documentCount(): int
  }
  class Segment <<inner>> {
    -lock: ReentrantReadWriteLock
    -buckets: Entry[]
    -size: int
    -resize()
  }
  class Entry <<inner>> {
    term: String
    hash: int
    postings: ArrayList<Posting>
    next: Entry
  }
  class Posting <<record>> {
    docId: int
    termFrequency: int
  }
}

package "concurrent" {
  class ThreadPool {
    -queue: ArrayDeque<Runnable>
    -workers: Thread[]
    +ThreadPool(threads: int)
    +submit(task: Runnable)
    +shutdown()
    +awaitTermination(timeout: long, unit: TimeUnit): boolean
    +activeCount(): int
    +queueSize(): int
  }
  note right of ThreadPool
    Власна черга: synchronized + wait/notify.
    submit після shutdown ->
    RejectedExecutionException.
  end note
}

package "cli" {
  class "cli.Main" as CliMain {
    +main(args)
    UTF-8 PrintStream для out/err
  }
  class Cli {
    +EXIT_OK = 0, EXIT_FAILURE = 1, EXIT_USAGE = 2
    +run(args: String[]): int
    -search(...)
    -health(...)
    -stats(...)
    -index(...)
    -readQuery(query): String  («-» = stdin, UTF-8)
  }
  class ArgsParser {
    +{static} parse(args): CliOptions
  }
  class CliOptions <<record>> {
    command: Command
    query: String
    url: String
    timeoutSeconds: Integer
    rest: boolean
    json: boolean
    indexThreads: Integer
  }
  enum "CliOptions.Command" as CliCommand {
    SEARCH
    HEALTH
    STATS
    INDEX
    HELP
  }
  class ServerUrl <<record>> {
    http: String
    ws: String
    +{static} parse(raw): ServerUrl
  }
  class ServerClient {
    +get(path, timeout): String
    +post(path, json, timeout): String
    ~{static} describeHttpError(status, body): String
  }
  class WsSearch {
    +search(requestJson, timeout, renderer)
  }
  class StageRenderer {
    +accept(message: String): boolean
    +failed(): boolean
  }
  class ResultFormatter {
    +LINE_WIDTH = 100
    +{static} expansionLine(terms): String
    +{static} printResults(out, results, timeMs)
    +{static} wrap(text, width): List<String>
  }
  class CliException <<checked, exit 1>>
  class UsageException <<checked, exit 2>>
}
note bottom of WsSearch
  java.net.http.WebSocket (JDK).
  Кожне повідомлення одразу йде в StageRenderer,
  тож етапи друкуються у міру надходження.
end note

ApiServer --> SearchService
ApiServer --> IndexManager
ApiServer --> OllamaClient : health
ApiServer ..> HealthResponse
ApiServer ..> IndexResponse
ApiServer ..> SearchResponse
ApiServer ..> StatsResponse
ApiServer ..> ErrorResponse
ApiServer ..> IndexingInProgressException : 409
ApiServer --> WsSearchHandler : /ws/search
ApiServer --> ThreadPool : searchPool (власний, SEARCH_THREADS)
WsSearchHandler --> ThreadPool : submit(drain)
WsSearchHandler --> SearchService : expandQuery, searchExpanded
WsSearchHandler *-- "N" Connection
WsSearchHandler +-- Sink
Connection --> Sink : send під sendLock
WsSearchHandler ..> WsMessage
WsMessage ..> WsExpansion
WsMessage ..> WsSearch
WsMessage ..> WsFailure
WsSearch o-- SearchResult

SearchService --> IndexManager : current().index()
SearchService --> Tokenizer
SearchService ..> QueryExpander : expandQuery
SearchService ..> QueryExpansion : returns
SearchService ..> ExpandedSearch : returns
ExpandedSearch o-- QueryExpansion
SearchService --> WeightedTerm
SearchService ..> SearchHit : returns
SearchService --> SnippetExtractor : top-K snippets
SnippetExtractor --> Tokenizer : body lines
ApiServer ..> SearchRequest
SearchResponse "1" o-- "*" SearchResult

QueryExpander --> TextGenerator
OllamaClient ..|> TextGenerator
OllamaClient ..> OllamaException : throws
TextGenerator ..> OllamaException : throws

IndexManager --> Indexer : creates for each build
IndexManager o-- IndexSnapshot : publishes
IndexSnapshot --> ConcurrentInvertedIndex
IndexManager ..> IndexingInProgressException : throws
Indexer --> ThreadPool : submits file tasks
Indexer --> Tokenizer
Indexer --> Chunker : межі чанків
Indexer --> BookEncoding : кодування файлу
IndexManager --> Chunker
SnippetExtractor --> Chunker : ті самі межі
SnippetExtractor --> BookEncoding
Chunker --> Tokenizer : рядки тіла книги
Indexer --> ConcurrentInvertedIndex : writes

CliMain --> Cli
Cli --> ArgsParser
ArgsParser --> CliOptions
CliOptions +-- CliCommand
Cli --> ServerUrl
Cli --> ServerClient : REST: --rest, --health, --stats, --index
Cli --> WsSearch : пошук за замовчуванням
WsSearch --> StageRenderer : кожне повідомлення одразу
Cli --> ResultFormatter
StageRenderer --> ResultFormatter
ArgsParser ..> UsageException : throws
ServerClient ..> CliException : throws
WsSearch ..> CliException : throws
note "CLI не залежить від серверних класів:\nговорить із сервером лише через HTTP/WebSocket." as CliNote

ConcurrentInvertedIndex "1" *-- "N" Segment : striped locks
Segment "1" *-- "*" Entry : bucket lists
Entry "1" o-- "*" Posting

note bottom of ConcurrentInvertedIndex
  Власна хеш-таблиця, без готових concurrent-колекцій.
  Сегментів 64 за замовчуванням. Термін -> сегмент за хешем; запис під write-lock
  сегмента, читання під read-lock. getPostings повертає копію.
  Реєстр документів: окремий ReadWriteLock.
end note

note as JsonNote
  У JSON поля мають snake_case за контрактом API
  (documents_indexed, time_ms, doc_id тощо).
end note

@enduml
