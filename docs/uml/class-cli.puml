@startuml class-cli
title Діаграма класів: модуль cli

skinparam shadowing false
skinparam classAttributeIconSize 0
skinparam nodesep 25
skinparam ranksep 35
set separator none
hide empty members

package "cli" {
  class "cli.Main" as CliMain {
    +main(args)
    UTF-8 PrintStream для out/err
  }
  class Cli {
    +EXIT_OK = 0, EXIT_FAILURE = 1, EXIT_USAGE = 2
    +run(args: String[]): int
    -search(...)
    -health(...)
    -stats(...)
    -index(...)
    -readQuery(query): String  («-» = stdin, UTF-8)
  }
  class ArgsParser {
    +{static} parse(args): CliOptions
  }
  class CliOptions <<record>> {
    command: Command
    query: String
    url: String
    timeoutSeconds: Integer
    rest: boolean
    json: boolean
    indexThreads: Integer
  }
  enum "CliOptions.Command" as CliCommand {
    SEARCH
    HEALTH
    STATS
    INDEX
    HELP
  }
  class ServerUrl <<record>> {
    http: String
    ws: String
    +{static} parse(raw): ServerUrl
  }
  class ServerClient {
    +get(path, timeout): String
    +post(path, json, timeout): String
    ~{static} describeHttpError(status, body): String
  }
  class "WsSearch" as CliWsSearch {
    +search(requestJson, timeout, renderer)
  }
  note bottom of CliWsSearch
    java.net.http.WebSocket (JDK).
    Кожне повідомлення одразу йде в StageRenderer,
    тож етапи друкуються у міру надходження.
  end note
  class StageRenderer {
    +accept(message: String): boolean
    +failed(): boolean
  }
  class ResultFormatter {
    +LINE_WIDTH = 100
    +{static} expansionLine(terms): String
    +{static} printResults(out, results, timeMs)
    +{static} wrap(text, width): List<String>
  }
  class CliException <<checked, exit 1>>
  class UsageException <<checked, exit 2>>
}

note "CLI не залежить від серверних класів:\nговорить із сервером лише через HTTP/WebSocket." as CliNote

CliMain --> Cli
Cli --> ArgsParser
ArgsParser --> CliOptions
CliOptions +-- CliCommand
Cli --> ServerUrl
Cli --> ServerClient : REST: --rest, --health, --stats, --index
Cli --> CliWsSearch : пошук за замовчуванням
CliWsSearch --> StageRenderer : кожне повідомлення одразу
Cli --> ResultFormatter
StageRenderer --> ResultFormatter
ArgsParser ..> UsageException : throws
ServerClient ..> CliException : throws
CliWsSearch ..> CliException : throws

@enduml
